{
  "title": "Music Theory Engine (REVISED)",
  "version": "2.0",
  "revision_note": "Useful thaat/sargam vocabulary. Now serves as a LABELING vocabulary with ten thaats, raga limitations, a chromatic-note policy, and separate theoretical spelling vs piano-key rendering. Removed unrelated flute-transposition guidance.",
  "purpose": "Provide thaat intervals, western equivalents, and sargam vocabulary for LABELING and candidate generation \u2014 never for hard filtering notes into a scale.",
  "usage_policy": {
    "labeling_only": "Thaats and scales are for LABELING and generating scale candidates, NOT for identifying ragas or for hard-filtering observed pitches.",
    "chromatic_notes": "Genuine chromatic, borrowed, or passing notes outside the thaat are musically valid and must be preserved. Show a scale-relative (sargam) label while retaining the observed chromatic pitch.",
    "spelling_vs_key": "Theoretical scale spelling (e.g. E# for the 7th of F# major) is separate from the piano key actually played (E# is rendered as F). Keep both correct."
  },
